# PostgreSQL connection string used by Prisma at runtime (pooled, e.g. Supabase/Supavisor on :6543 in prod)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catarse_interatividade?schema=public"

# Direct (non-pooled) connection used by Prisma for `migrate deploy`/`migrate dev`
# (session-mode advisory locks aren't supported over a transaction-mode pooler).
# Locally this is normally the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/catarse_interatividade?schema=public"

# Porta do servidor HTTP + Socket.IO
PORT=3000

# Origem pública usada para montar links de sala (QR code, telão, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
