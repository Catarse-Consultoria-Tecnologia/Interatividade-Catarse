# Postgres via Supabase — em produção use as connection strings do seu projeto:
# Project Settings > Database > Connection string.
# DATABASE_URL: connection pooler (porta 6543) — usada em runtime pela aplicação.
# DIRECT_URL: conexão direta (porta 5432) — usada só pelo Prisma Migrate.
# Em dev local sem Supabase, as duas podem apontar pro mesmo Postgres local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catarse_interatividade?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/catarse_interatividade?schema=public"

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Origem pública usada para montar links de sala (QR code, telão, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
