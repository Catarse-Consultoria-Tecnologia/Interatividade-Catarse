# PostgreSQL connection string used by Prisma at runtime (pode ser a conexão
# via pooler/PgBouncer em produção, ex. Supabase "Transaction pooler")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catarse_interatividade?schema=public"

# Conexão direta (sem pooler), usada só por `prisma migrate deploy`/`migrate dev`.
# Em produção (Supabase), use a connection string "Direct connection" (porta 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/catarse_interatividade?schema=public"

# Porta do servidor HTTP + Socket.IO
PORT=3000

# Origem pública usada para montar links de sala (QR code, telão, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
